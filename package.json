{
	"name": "mycocepurus-smithii",
	"version": "0.0.0",
	"description": "Idempotency-Key handling to the IETF draft: one execution per key, exact replay, hard conflict on a reused key, atomic claim against concurrent copies. Bring your own store.",
	"type": "module",
	"sideEffects": false,
	"main": "dist/index.js",
	"types": "dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/index.js"
		},
		"./http": {
			"types": "./dist/types/http.d.ts",
			"default": "./dist/http.js"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "node --import tsx --test \"tests/**/*.test.ts\"",
		"docs": "typedoc",
		"changelog": "git-cliff -o CHANGELOG.md",
		"prepare": "lefthook install"
	},
	"keywords": [
		"idempotency",
		"idempotency-key",
		"idempotent",
		"http",
		"retry",
		"typescript",
		"esm"
	],
	"author": "grml",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Smiduweorc/mycocepurus-smithii.git"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.1",
		"eslint": "^10.10.0",
		"git-cliff": "^2.13.1",
		"lefthook": "^2.1.14",
		"tsx": "^4.23.13",
		"typedoc": "^0.28.20",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.70.0"
	}
}
